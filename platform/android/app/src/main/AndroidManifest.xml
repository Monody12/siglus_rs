<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.chino.siglus">

    <!-- Required for direct filesystem access in strict no-copy import mode. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Siglus">

        <!-- Foreground keep-alive for the in-app data downloader -->
        <service
            android:name=".DataDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Dedicated-game bootstrap: launch straight into the game -->
        <activity
            android:name=".ClannadBootstrapActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Siglus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Generic multi-engine launcher UI (secondary entry) -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Siglus">
        </activity>

        <!-- Player / native rendering -->
        <activity
            android:name=".SiglusGameActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Siglus"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">
        </activity>

        <!-- Player for RealLive / AVG32 / UK2 (framebuffer runtime) -->
        <activity
            android:name=".FramebufferGameActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Siglus"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">
        </activity>

    </application>

</manifest>
